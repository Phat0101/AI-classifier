FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN pip install --no-cache-dir uv

# Copy project files (Railway context is backend/ directory)
COPY pyproject.toml uv.lock ./
COPY src ./src

# Copy checklists - they should be in backend/checklists for Railway
# OR you can mount them as a volume in Railway
COPY checklists ./checklists

# Install dependencies using uv
RUN uv sync --frozen

# Create output directory for file storage
RUN mkdir -p /app/output

# Expose port - Railway will provide this via $PORT
EXPOSE 8000

# Health check
HEALTHCHECK --interval=300s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/health || exit 1

# Run the application using granian ASGI server with access logs
# Use $PORT environment variable provided by Railway (defaults to 8000)
CMD ["sh", "-c", "uv run granian --host 0.0.0.0 --port ${PORT:-8000} --interface asgi --access-log --log-level info src.ai_classifier.main:app"]

